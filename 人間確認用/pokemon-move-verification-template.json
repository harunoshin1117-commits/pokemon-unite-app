{
  "templateName": "cinderace-blaze-flare-defense-rounding-check",
  "title": "エースバーン・もうか火種 防御補正・丸め順検証",
  "fields": [
    {
      "id": "pokemon",
      "label": "ポケモン",
      "type": "input",
      "placeholder": "例: エースバーン",
      "defaultValue": "エースバーン"
    },
    {
      "id": "move",
      "label": "検証対象",
      "type": "input",
      "placeholder": "例: 特性「もうか」火種 防御補正・丸め順",
      "defaultValue": "特性「もうか」火種 防御補正・丸め順"
    },
    {
      "id": "attackerLevel",
      "label": "攻撃側レベル",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 15",
      "defaultValue": "15"
    },
    {
      "id": "attackerStats",
      "label": "攻撃側ステータス",
      "type": "textarea",
      "className": "full",
      "placeholder": "例: 攻撃418 / 持ち物なし / メダルなし",
      "defaultValue": "攻撃418 / 持ち物なし / メダルなし"
    },
    {
      "id": "targetPokemon",
      "label": "相手ポケモン",
      "type": "input",
      "placeholder": "例: ピカチュウ / エースバーン / ゲッコウガ",
      "defaultValue": "ピカチュウ"
    },
    {
      "id": "targetLevel",
      "label": "相手レベル",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 15",
      "defaultValue": "15"
    },
    {
      "id": "targetMaxHp",
      "label": "相手最大HP",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 6300",
      "defaultValue": ""
    },
    {
      "id": "targetDefense",
      "label": "相手防御",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 240",
      "defaultValue": ""
    },
    {
      "id": "targetCurrentHp",
      "label": "命中直前の相手HP",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 発火攻撃が当たる直前のHP",
      "defaultValue": ""
    },
    {
      "id": "heldItems",
      "label": "持ち物",
      "type": "input",
      "placeholder": "例: なし",
      "defaultValue": "なし"
    },
    {
      "id": "emblems",
      "label": "メダル",
      "type": "input",
      "placeholder": "例: なし",
      "defaultValue": "なし"
    },
    {
      "id": "critical",
      "label": "本体急所",
      "type": "choice",
      "className": "full",
      "defaultValue": "なし / 不明",
      "options": [
        "なし",
        "あり",
        "不明",
        "なし / 不明",
        "混在"
      ]
    },
    {
      "id": "startingCinderStacks",
      "label": "発火前の火種数",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 4 または 3",
      "defaultValue": "4"
    },
    {
      "id": "triggerAction",
      "label": "発火させた攻撃",
      "type": "choice",
      "className": "full",
      "defaultValue": "通常攻撃",
      "options": [
        "通常攻撃",
        "強化通常攻撃",
        "技",
        "その他"
      ]
    },
    {
      "id": "triggerMoveName",
      "label": "技名・攻撃名",
      "type": "input",
      "placeholder": "例: 通常攻撃 / 強化通常攻撃 / ニトロチャージ",
      "defaultValue": "通常攻撃"
    },
    {
      "id": "bodyDamageDisplay",
      "label": "攻撃本体ダメージ表示",
      "type": "input",
      "placeholder": "例: 298",
      "defaultValue": ""
    },
    {
      "id": "flareDamageDisplay",
      "label": "火種追加ダメージ表示",
      "type": "input",
      "placeholder": "例: 726",
      "defaultValue": ""
    },
    {
      "id": "hpAfterFlare",
      "label": "本体+火種後の相手HP",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 最終HP。自然回復が入ったら補足へ",
      "defaultValue": ""
    },
    {
      "id": "naturalRecoveryObserved",
      "label": "自然回復らしきズレ",
      "type": "choice",
      "className": "full",
      "defaultValue": "不明",
      "options": [
        "なし",
        "あり",
        "不明"
      ]
    },
    {
      "id": "measuredDamage1",
      "label": "実測ダメージ 1回目",
      "type": "input",
      "placeholder": "例: 本体298 / 火種726",
      "defaultValue": ""
    },
    {
      "id": "measuredDamage2",
      "label": "実測ダメージ 2回目",
      "type": "input",
      "placeholder": "例: 同条件2回目",
      "defaultValue": ""
    },
    {
      "id": "measuredDamage3",
      "label": "実測ダメージ 3回目",
      "type": "input",
      "placeholder": "例: 同条件3回目",
      "defaultValue": ""
    },
    {
      "id": "displayCount",
      "label": "表示回数",
      "type": "input",
      "inputmode": "numeric",
      "placeholder": "例: 本体と火種で2回",
      "defaultValue": ""
    },
    {
      "id": "notes",
      "label": "補足",
      "type": "textarea",
      "className": "full",
      "placeholder": "例: 相手を変えて火種追加ダメージを測る。自然回復が入った場合は+値を記録。",
      "defaultValue": "火種追加ダメージ726の丸め順と防御補正を切り分ける検証。相手ポケモンを変えて、最大HP・防御・火種追加ダメージを記録する。野生ポケモンは上限500が混ざるため使わない。最終HPが計算とずれる場合、最大HPの1%自然回復が入った可能性を確認する。"
    }
  ]
}
