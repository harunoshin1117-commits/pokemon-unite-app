# Normalize text files to LF so large research JSON/docs do not churn on Windows.
* text=auto eol=lf

# Binary assets must not be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.7z binary
*.rar binary
*.mp4 binary
*.MP4 binary
*.mov binary
*.MOV binary
*.mkv binary
*.avi binary
*.webm binary
*.m4v binary
